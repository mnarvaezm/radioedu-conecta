parameters:
    level: 6
    paths:
        - radioedu-conecta.php
        - uninstall.php
        - src/
        - templates/
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    dynamicConstantNames:
        - RADIOEDU_CONECTA_URL
        # The requirement check compares it with the PHP version of the site, not the analyser's.
        - RADIOEDU_CONECTA_MIN_PHP
