{
  "name": "radioedu/radioedu-conecta",
  "description": "Directorio colaborativo y sistema de propuestas para la red de radios escolares Traspasando Fronteras (RadioEdu - Educarex).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "RadioEdu - Junta de Extremadura",
      "homepage": "https://radioedu.educarex.es"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "RadioEdu\\Conecta\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RadioEdu\\Conecta\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint:php": "phpcs",
    "stan": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
