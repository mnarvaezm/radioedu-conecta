#: src/Network/NetworkSync.php:212
msgid "Otra sincronización está actualizando la ficha de este sitio. Vuelve a sincronizar dentro de un momento."
msgstr "Beste sinkronizazio bat gune honen fitxa eguneratzen ari da. Sinkronizatu berriro une bat barru."

